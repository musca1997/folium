# Folium environment example
# Copy to .env.local and adjust before deploying.

# Optional OpenAI-compatible LLM provider. If absent or failing, Folium uses a deterministic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Single-user auth defaults. Change before exposing Folium beyond localhost.
FOLIUM_USERNAME=admin
FOLIUM_PASSWORD=change-me
FOLIUM_SESSION_SECRET=change-this-to-a-long-random-string

# Optional Wikidata reconciliation controls.
FOLIUM_WIKIDATA_ENABLED=true
FOLIUM_WIKIDATA_TIMEOUT_MS=2500
